# Shared Sanity credentials. Each app reads its own .env (copy this file there).
# Dataset is public on the current plan: documents whose _id contains a "."
# (e.g. "private.<uuid>") are only readable with a token; nothing uses that today.
SANITY_PROJECT_ID=lboasusv
SANITY_DATASET=production
# Read token (Viewer) for builds; never expose to the browser.
SANITY_API_READ_TOKEN=

# Canonical origins
PUBLIC_SITE_URL=https://nibras.co

# Cross-links between the apps. Leave unset: `astro dev` uses the local ports (web :4321,
# archive :4322) and builds use the public addresses. Set one only to point dev elsewhere.
# PUBLIC_WEB_URL=https://nibras.co
# PUBLIC_ARCHIVE_URL=https://archive.nibras.co
