---
/**
 * Gri, the mascot, drawn in the page so it can change its mood. This is `face.astro` with the
 * first face; see that file for the other two, and for how a script changes the mood.
 */
import Face from "./face.astro"
import type { Mood } from "./gri"

interface Props {
  /** The moods this drawing can show. The first one shows at the start. Fewer moods, less HTML. */
  moods?: readonly Mood[]
  /** The marks around the head, such as hearts. Leave them out below about 3rem. */
  marks?: boolean
  /** A face that the page mixes from three moods. It holds every mood. */
  mix?: boolean
}
---

<Face who="gri" {...Astro.props} />
