---
import CommandBar from "./command-bar.astro"
import Gri from "./gri.astro"
import Icon from "./icon.astro"
import ThemeToggle from "./theme-toggle.astro"

interface Props {
  /** `wide` lines up with full-width pages such as the media gallery. */
  wide?: boolean
  /** "" on nibras.co; "https://nibras.co" on the other sites, so the links go to the main site. */
  origin?: string
  name?: string
  avatar?: string | null
  /**
   * Draw the mascot in the page in place of the `avatar` picture, so it can answer a theme
   * change. For a profile whose icon is the mascot.
   */
  mascot?: boolean
  /**
   * Hide the avatar and name until the element marked `data-hero` scrolls under the header.
   * For the home page, where the hero already shows both.
   */
  revealBrand?: boolean
  /** Show how far the page is scrolled, as a line under the header. For posts. */
  progress?: boolean
}

const {
  origin = "",
  name = "Griko Nibras",
  avatar,
  mascot,
  wide,
  revealBrand,
  progress,
} = Astro.props
const pictured = mascot || avatar
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const NAV = [
  { href: "/blog", label: "Blog" },
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/now", label: "Now" },
]
const current = (href: string) =>
  !origin && (path === href || path.startsWith(`${href}/`)) ? "page" : undefined
---

<div class="site-header sticky top-0 z-40" data-print="hide">
  <div class="site-header-ground" aria-hidden="true"></div>
  <header
    class:list={[
      "mx-auto flex w-full items-center justify-between gap-3 px-5 py-4",
      wide ? "max-w-6xl" : "max-w-2xl",
    ]}
  >
    <div class:list={[revealBrand && "brand-clip"]}>
      <a
        href={`${origin}/`}
        class:list={[
          "flex min-h-9 min-w-9 items-center gap-2.5 font-bold tracking-tight",
          revealBrand && "brand-reveal",
        ]}
      >
        {mascot ? (
          <span class="size-7 shrink-0 overflow-hidden rounded-full border border-line">
            <Gri moods={["smile", "cool", "cheeky"]} marks={false} />
          </span>
        ) : (
          avatar && (
            <img
              src={`${avatar}?w=72&h=72&fit=crop&auto=format`}
              width="28"
              height="28"
              alt=""
              class="size-7 rounded-full border border-line bg-white"
            />
          )
        )}
        <span class:list={[pictured && "max-[25rem]:sr-only"]}>{name}</span>
      </a>
    </div>
    <nav aria-label="Main" class="flex items-center gap-1">
      <ul class="flex items-center text-[0.9375rem]">
        {NAV.map((item) => (
          <li>
            <a
              href={`${origin}${item.href}`}
              aria-current={current(item.href)}
              class="block rounded-md px-2 py-1.5 text-soft max-[22rem]:px-1 transition-colors hover:text-fg aria-[current=page]:text-fg aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[6px]"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <button
        type="button"
        class="grid size-9 cursor-pointer place-items-center rounded-full text-soft transition-colors hover:bg-sunk hover:text-fg"
        aria-label="Search"
        aria-haspopup="dialog"
        aria-keyshortcuts="Meta+K Control+K /"
        data-command-open
        hidden
      >
        <Icon name="search" class="size-[1.125rem]" stroke={2} />
      </button>
      {/* Shows the button before the first paint, so the links do not move. Without
          JavaScript, or in a browser with no dialog element, there is no bar and no button. */}
      <script is:inline>
        if (window.HTMLDialogElement && "showModal" in HTMLDialogElement.prototype) {
          for (const button of document.querySelectorAll("[data-command-open]")) {
            button.hidden = false
          }
        }
      </script>
      <ThemeToggle />
    </nav>
  </header>
  {progress && <div class="read-progress" aria-hidden="true" />}
</div>
<CommandBar origin={origin} mascot={mascot} />
{revealBrand && <script is:inline>
  // States the two ends of the brand reveal (styles.css). Between them the scroll timeline
  // moves the brand; where no timeline runs, the brand waits until the avatar is gone.
  {
    const root = document.documentElement
    root.dataset.brand = "hidden"
    addEventListener("DOMContentLoaded", () => {
      const hero = document.querySelector("[data-hero]")
      const brand = document.querySelector(".brand-reveal")
      if (!hero || !brand || !("IntersectionObserver" in window)) {
        delete root.dataset.brand
        return
      }
      const scrubs = () =>
        brand.getAnimations().some((animation) => animation.timeline?.currentTime != null)
      // The header is 4.5rem tall: the avatar leaves the view at its lower edge.
      const header = 4.5 * parseFloat(getComputedStyle(root).fontSize)
      new IntersectionObserver(
        (entries) => {
          const entry = entries[entries.length - 1]
          if (entry.intersectionRatio > 0.99) root.dataset.brand = "hidden"
          else if (!entry.isIntersecting) root.dataset.brand = "shown"
          else root.dataset.brand = scrubs() ? "moving" : "hidden"
        },
        { rootMargin: `-${header}px 0px 0px`, threshold: [0, 0.99, 1] },
      ).observe(hero)
    })
  }
</script>}
