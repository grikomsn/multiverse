---
import { FALLBACK_NAME } from "@multiverse/sanity/constants"

import BrandIcon from "./brand-icon.astro"
import DitherBand from "./dither-band.astro"
import Icon from "./icon.astro"
import ProgressiveBlur from "./progressive-blur.astro"

interface Props {
  /** `wide` lines up with full-width pages such as the media gallery. */
  wide?: boolean
  origin?: string
  name?: string | null
  /** Leave empty on pages that already show the email, such as the home page. */
  email?: string | null
  scheduleUrl?: string | null
  profiles?: { label: string; url: string; platform?: string | null }[]
  /** How many older versions archive.nibras.co has. Zero hides the link. */
  versions?: number
  /** Where "Older versions" goes. Web sets `http://localhost:4322` in dev. */
  archiveUrl?: string
}

const {
  origin = "",
  name,
  email,
  scheduleUrl,
  profiles = [],
  versions = 0,
  wide,
  archiveUrl = "https://archive.nibras.co",
} = Astro.props
// Icon-only links: the label is the tooltip and the accessible name.
type FooterLink = {
  label: string
  href: string
  rel?: string
  platform?: string | null
  icon?: "rss" | "file-text" | "image" | "bot"
}
const links: FooterLink[] = [
  ...profiles.map((profile) => ({
    label: profile.label,
    href: profile.url,
    rel: "me",
    platform: profile.platform,
  })),
  { label: "Resume", href: `${origin}/resume`, icon: "file-text" },
  { label: "Photos and avatars", href: `${origin}/media`, icon: "image" },
  { label: "RSS feed", href: `${origin}/feed.xml`, icon: "rss" },
  { label: "For AI tools", href: `${origin}/ai`, icon: "bot" },
]
---

<footer class="mt-20" data-print="hide">
  <div
    class:list={[
      "mx-auto flex w-full flex-col gap-5 px-5 pb-8 text-[0.9375rem] text-soft",
      wide ? "max-w-6xl" : "max-w-2xl",
    ]}
  >
    <div class="border-t border-line"></div>
    {email && (
      <p>
        Send an email to{" "}
        <a class="quiet-link text-fg" href={`mailto:${email}`}>
          {email}
        </a>
        {scheduleUrl ? (
          <>
            , or{" "}
            <a class="quiet-link text-fg" href={scheduleUrl}>
              book a call
            </a>
            .
          </>
        ) : (
          "."
        )}
      </p>
    )}
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <ul class="-mx-2 flex flex-wrap" aria-label="Links">
        {links.map((link) => (
          <li>
            <a
              class="flex size-9 items-center justify-center rounded-md transition-colors hover:text-fg"
              href={link.href}
              rel={link.rel}
              aria-label={link.label}
              data-tooltip={link.label}
            >
              {link.platform && <BrandIcon platform={link.platform} class="size-[1.125rem]" />}
              {link.icon && <Icon name={link.icon} class="size-[1.125rem]" />}
            </a>
          </li>
        ))}
      </ul>
      {versions > 0 && (
        <a class="link inline-block py-1 text-fg" href={archiveUrl}>
          Older versions ({versions})
        </a>
      )}
    </div>
    <p class="mt-9 flex flex-col gap-1 text-sm">
      <span>
        © {new Date().getFullYear()} {name ?? FALLBACK_NAME}
      </span>
      <span class="[&_a]:quiet-link [&_a]:hover:text-fg">
        Made with <a href="https://astro.build">Astro</a> and{" "}
        <a href="https://www.sanity.io">Sanity</a>. Hosted on{" "}
        <a href="https://www.cloudflare.com">Cloudflare</a>.
      </span>
    </p>
  </div>
  <DitherBand />
</footer>
<ProgressiveBlur edge="bottom" class="page-end-blur" />

<script>
  // The blur at the window's lower edge is off while the footer's band is in view.
  const blur = document.querySelector(".page-end-blur")
  const band = document.querySelector("[data-dither-band]")
  if (blur && band) {
    new IntersectionObserver(([entry]) => {
      blur.classList.toggle("is-off", entry!.isIntersecting)
    }).observe(band)
  }
</script>
