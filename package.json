{
  "name": "multiverse",
  "version": "0.0.0",
  "private": true,
  "description": "Griko Nibras's sites (nibras.co, its archive of every past version, and nbr.st) and the Sanity CMS that feeds them",
  "homepage": "https://nibras.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grikomsn/multiverse.git"
