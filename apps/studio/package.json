    "typecheck": "tsc"
  },
  "dependencies": {
    "@multiverse/sanity": "workspace:*",
    "@sanity/vision": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:",
    "styled-components": "catalog:"
  },
  "devDependencies": {
    "@multiverse/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
