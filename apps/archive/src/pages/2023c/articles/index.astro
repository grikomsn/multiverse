---
import { getEdition, pageOf } from "../../../lib/editions"
import Icon from "../../../editions/2023c/icon.astro"
import Layout from "../../../editions/2023c/layout.astro"
import { BASE, formatDate } from "../../../editions/2023c/paths"

const edition = await getEdition("2023c")
const page = pageOf(edition, "articles")
---

<Layout pageTitle="Articles" description={page?.description} backToTop>
  <section class="container fade-bottom py-8 lg:py-16">
    <h1 class="max-w-screen-sm text-4xl font-bold">{page?.title}</h1>
    <p class="max-w-screen-sm space-y-4 text-neutral-700 dark:text-neutral-300">
      {page?.description}
    </p>
    <br />
    <br />
    <ul class="max-w-screen-sm space-y-12">
      {edition.posts?.map((post) => (
        <li class="group relative flex flex-col before:absolute before:-inset-4 before:-z-10 before:rounded-lg before:bg-neutral-500/5 before:opacity-0 before:transition-[opacity,inset] hover:before:-inset-6 hover:before:opacity-100 dark:before:bg-neutral-500/10">
          <div class="mb-2 text-xl font-bold">{post.title}</div>
          <div class="mb-2 text-sm text-neutral-700 dark:text-neutral-300">{post.excerpt}</div>
          <div class="mt-4 flex items-center gap-x-2 text-sm text-neutral-700 dark:text-neutral-300">
            <Icon name="calendar" class="h-3 w-3" />
            {post.publishedAt && (
              <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
            )}
            <div class="flex-grow" />
            <a
              href={`${BASE}/articles/${post.slug}`}
              class="flex items-center gap-x-2 text-primary-600 before:absolute before:-inset-4 hover:underline dark:text-primary-500"
            >
              <div>Read article</div>
              <Icon name="arrow-right" class="h-3 w-3" />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Layout>
