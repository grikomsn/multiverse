---
import Layout from "../../editions/2022b/layout.astro"
import { BASE } from "../../editions/2022b/paths"
---

<Layout pageTitle="404 — Page not found" bodyClass="error-template">
  <main class="outer error-content">
    <div class="inner">
      <section class="error-message">
        <h1 class="error-code">404</h1>
        <p class="error-description">Page not found</p>
        <a class="error-link" href={`${BASE}/`}>
          Go to the front page →
        </a>
      </section>
    </div>
  </main>
</Layout>
