---
import type { GetStaticPaths } from "astro"

import Layout from "../../editions/2024/layout.astro"
import { dateTime, formatDate } from "../../editions/2024/paths"
import RichText from "../../editions/2024/rich-text.astro"
import { getEdition } from "../../lib/editions"

/** Bear serves posts and pages from the same root: /<slug>/. */
export const getStaticPaths = (async () => {
  const edition = await getEdition("2024")
  return [
    ...(edition.posts ?? []).map((post) => ({
      params: { slug: post.slug },
      props: {
        title: post.title,
        description: post.excerpt,
        date: post.publishedAt,
        body: post.body,
        isPost: true,
      },
    })),
    ...(edition.pages ?? [])
      .filter((page) => page.slug && !page.slug.includes("/"))
      .map((page) => ({
        params: { slug: page.slug! },
        props: {
          title: page.title,
          description: page.description,
          date: null,
          body: page.body,
          isPost: false,
        },
      })),
  ]
}) satisfies GetStaticPaths

const { title, description, date, body, isPost } = Astro.props
---

<Layout pageTitle={title} description={description} bodyClass={isPost ? "post " : "page "}>
  <h1>{title}</h1>
  {isPost && date && (
    <p>
      <i>
        <time datetime={dateTime(date)}>{formatDate(date)}</time>
      </i>
    </p>
  )}
  <RichText value={body} />
  {isPost && (
    <small>
      <span class="upvote-button" title="Toast this post">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          stroke="currentColor"
          stroke-width="2"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="17 11 12 6 7 11" />
          <polyline points="17 18 12 13 7 18" />
        </svg>
      </span>
    </small>
  )}
</Layout>
