---
/** pages/contact.tsx */
import type { Edition } from "../../lib/editions"
import { pageOf } from "../../lib/editions"
import A from "./a.astro"
import Content from "./content.astro"
import Main from "./main.astro"
import RichText from "./rich-text.astro"

type Props = { edition: Edition }

const { edition } = Astro.props
const page = pageOf(edition, "contact")
const groups = Map.groupBy(edition.links ?? [], (link) => link.group ?? "")
---

<Main>
  <Content>
    <h1>{page?.title}</h1>
    <RichText value={page?.body} />

    {[...groups].map(([name, links]) => (
      <>
        <h3>{name}</h3>
        <ul>
          {links.map(({ label, url }) => (
            <li>
              <span class="font-semibold">{label}</span>
              {" - "}
              <A href={url} />
            </li>
          ))}
        </ul>
      </>
    ))}
  </Content>
</Main>
