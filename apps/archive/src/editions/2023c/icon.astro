---
import { ICONS, type IconName } from "./icons"

interface Props {
  name: IconName
  class?: string
}

const { name, class: className } = Astro.props
const lucide = name !== "mastodon"
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={[lucide && `lucide lucide-${name}`, className]}
  aria-hidden="true"
  set:html={ICONS[name]}
/>
