---
import type { Mark } from "astro-portabletext/types"

import { href } from "./paths"

type Props = { node: Mark<{ href: string }> }

const target = Astro.props.node.markDef.href
const external = /^https?:/.test(target)
---

<a href={href(target)} {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
  <slot />
</a>
