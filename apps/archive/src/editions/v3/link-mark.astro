---
/** components/Link.js for outbound links (new tab), plain anchors for site paths. */
import type { Mark } from "astro-portabletext/types"

import { href as resolve } from "./paths"

type Props = { node: Mark<{ href: string }> }

const { href } = Astro.props.node.markDef
const external = /^https?:/.test(href)
---

<a href={resolve(href)} {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
  <slot />
</a>
