---
import "./v3.css"

import ArchiveBanner from "../../shell/archive-banner.astro"
import ArchiveHead from "../../shell/archive-head.astro"
import { getEdition, imageUrl, period } from "../../lib/editions"
import { assetOf } from "../../lib/live"
import { COLOPHON, copyright } from "../_kit/colophon"
import { BASE } from "./paths"

interface Props {
  pageTitle?: string
  description?: string | null
  class?: string
  hideFooter?: boolean
}

const { pageTitle, description, class: className, hideFooter } = Astro.props
const edition = await getEdition("v3")
const siteTitle = edition.name ?? "Griko Nibras"
const title = pageTitle ? `${siteTitle} • ${pageTitle}` : siteTitle
const icon = assetOf(edition, "icon")?.image?.url
const ROUTES = [
  { name: "Blog", route: "/blog" },
  { name: "Open Source", route: "/open-source" },
  { name: "Socials", route: "/socials" },
  { name: "About", route: "/about" },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width,initial-scale=1.0,user-scalable=yes" name="viewport" />
    <title>{title}</title>
    <meta content={description ?? edition.description} name="description" />
    <meta content="#f8f88f" name="theme-color" />
    {icon && <link href={imageUrl(icon, 32)} rel="icon" sizes="32x32" type="image/png" />}
    {icon && <link href={imageUrl(icon, 180)} rel="apple-touch-icon" sizes="180x180" />}
    <ArchiveHead />
  </head>
  <body>
    <div class:list={["v3-wrapper", className]}>
      <div class="v3-header">
        <nav class="navbar is-warning" aria-label="main navigation">
          <div class="navbar-brand">
            <div class="navbar-padding"></div>
            <a href={`${BASE}/`} class="navbar-item remove-animation">
              {edition.avatar?.url && (
                <img
                  class="v3-icon"
                  alt="Ainami"
                  src={imageUrl(edition.avatar.url, 192)}
                  width="24"
                  height="28"
                />
              )}
              &nbsp;
              <b>{siteTitle}</b>
            </a>
            <a
              role="button"
              class="navbar-burger burger"
              tabindex="0"
              aria-label="menu"
              aria-expanded="false"
              data-v3-burger
            >
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
            </a>
          </div>
          <div class="navbar-menu has-text-centered" data-v3-menu>
            <div class="navbar-end">
              {ROUTES.map(({ name, route }) => (
                <a href={`${BASE}${route}`} class="navbar-item">
                  {name}
                </a>
              ))}
            </div>
          </div>
          <div class="navbar-padding"></div>
        </nav>
      </div>
      <main class="v3-main">
        <slot />
      </main>
      {!hideFooter && (
        <footer class="footer has-background-dark has-text-light has-text-centered">
          <small>
            <p>
              Handcrafted with <i class="e1a-heart" /> by myself. Copyright &copy; {copyright()}.{" "}
              <br />
              Made with{" "}
              <a
                href="https://bulma.io"
                class="reset-color"
                rel="noopener noreferrer"
                target="_blank"
              >
                <b>Bulma</b>
              </a>{" "}
              and{" "}
              <a
                href={COLOPHON.framework.url}
                class="reset-color"
                rel="noopener noreferrer"
                target="_blank"
              >
                <b>{COLOPHON.framework.name}</b>
              </a>
              .
            </p>
            <br />
            <p>
              Hosted on{" "}
              <a
                href={COLOPHON.host.url}
                class="reset-color"
                rel="noopener noreferrer"
                target="_blank"
              >
                <b>{COLOPHON.host.name}</b>
              </a>
              . Source available on{" "}
              <a
                href={COLOPHON.source("v3")}
                class="reset-color"
                rel="noopener noreferrer"
                target="_blank"
              >
                <b>GitHub</b>
              </a>
              .
            </p>
          </small>
        </footer>
      )}
    </div>
    <ArchiveBanner
      title={edition.title ?? "Version 3"}
      period={period(edition.startDate, edition.endDate)}
    />
    <script>
      const burger = document.querySelector<HTMLElement>("[data-v3-burger]")
      const menu = document.querySelector<HTMLElement>("[data-v3-menu]")
      const toggle = (event: Event) => {
        event.preventDefault()
        const open = !menu?.classList.contains("is-active")
        burger?.classList.toggle("is-active", open)
        menu?.classList.toggle("is-active", open)
        burger?.setAttribute("aria-expanded", String(open))
      }
      burger?.addEventListener("click", toggle)
      burger?.addEventListener("keypress", toggle)

      // react-pose exit: slide the header up and fade the page out before leaving.
      document.addEventListener("click", (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>("a[href^='/v3']")
        if (!link || event.metaKey || event.ctrlKey || event.shiftKey || link.target) return
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return
        event.preventDefault()
        document.body.classList.add("v3-leaving")
        setTimeout(() => location.assign(link.href), 300)
      })
      addEventListener("pageshow", () => document.body.classList.remove("v3-leaving"))
    </script>
  </body>
</html>
