---
/** MDX bodies (posts, pages, the home excerpt) with v9's MDX components. */
import { PortableText } from "astro-portabletext"
import type { Block, PortableTextProps, RenderHandlerProps } from "astro-portabletext/types"

import CodeBlock from "./code-block.astro"
import Embed from "../_kit/embed.astro"
import Figure from "./figure.astro"
import Bold from "./bold-mark.astro"
import Lead from "./lead-block.astro"
import LinkMark from "./link-mark.astro"

type Props = { value: unknown[] | null | undefined; h2AsH1?: boolean }

// Imported image blocks that lost their asset carry no `_type`; skip them.
const value = (Astro.props.value ?? []).filter(
  (node): node is { _type: string } => typeof node === "object" && node !== null && "_type" in node,
) as PortableTextProps["value"]
const { h2AsH1 } = Astro.props
---

<PortableText
  value={value}
  components={{
    type: { codeBlock: CodeBlock, figure: Figure, embed: Embed },
    block: { normal: Lead },
    mark: { link: LinkMark, strong: Bold },
  }}
>
  <fragment slot="block">
    {({ Component, props, children }: RenderHandlerProps<Block>) =>
      h2AsH1 && props.node.style === "h2" ? (
        <h1>{children}</h1>
      ) : (
        <Component {...props}>{children}</Component>
      )
    }
  </fragment>
</PortableText>
