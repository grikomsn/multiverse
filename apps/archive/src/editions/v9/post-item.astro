---
import A from "./a.astro"
import Icon from "./icon.astro"
import { formatDate, type PostEntry } from "./paths"

interface Props {
  post: PostEntry
}

const { post } = Astro.props
const shown = post.redirect ?? `/blog/${post.slug}`
---

<li class="group relative flex flex-col p-4 sm:rounded-xl sm:hover:bg-neutral-800">
  <h4 class="mb-2 line-clamp-3 text-lg font-bold">{post.title}</h4>
  <p class="mb-4 line-clamp-3 max-w-2xl text-neutral-400">{post.description}</p>
  <div class="mb-2 flex items-center gap-2">
    <Icon name="calendar" class="h-3 w-3 text-neutral-400" />
    <span class="text-xs text-neutral-400">{formatDate(post.date)}</span>
  </div>
  <A
    class="flex items-center gap-2 before:inset-0 before:content-[''] sm:before:absolute"
    href={shown}
  >
    <Icon name={post.redirect ? "internet" : "link"} class="h-3 w-3 text-neutral-400" />
    <span
      class:list={[
        "line-clamp-1 text-xs hover:underline sm:group-hover:underline",
        post.redirect ? "text-blue-400" : "text-primary-500",
      ]}
    >
      {shown}
    </span>
  </A>
</li>
