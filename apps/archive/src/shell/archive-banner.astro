---
/**
 * Small fixed pill on every archived page. Styles are scoped and self-contained so they
 * survive whatever CSS framework the edition ships: lengths are in px, because editions set
 * different root font sizes. Every version shows today's content in its old design.
 *
 * The pill is one line, 34px tall, and takes the 48px above the lower edge of the window.
 * An edition keeps that space free in one of two ways:
 *
 * - A floating control (a menu button, a dock) sits at least 48px above the lower edge.
 * - A bar that touches the lower edge sets `--archive-banner-lift` on `:root` to its height,
 *   and the pill moves above it.
 */
interface Props {
  title: string
  period: string
}

import { WEB_ORIGIN } from "../lib/web"

const { title, period } = Astro.props
---

<aside class="archive-banner" aria-label="Archived version">
  <span class="archive-banner-name">
    <span class="archive-banner-wide">Archived: </span>
    {title}, {period}
  </span>
  <span class="archive-banner-mode archive-banner-wide">Today's content</span>
  <a href="/">All versions</a>
  <a href={WEB_ORIGIN}>Current site</a>
</aside>

<style>
  .archive-banner {
    position: fixed;
    right: 16px;
    bottom: calc(10px + var(--archive-banner-lift, 0px) + env(safe-area-inset-bottom, 0px));
    z-index: 2147483647;
    display: flex;
    gap: 12px;
    align-items: center;
    box-sizing: border-box;
    max-width: calc(100vw - 32px);
    height: 34px;
    margin: 0;
    padding: 0 14px;
    border: 1px solid #3f3f46;
    border-radius: 999px;
    background: #18181b;
    box-shadow: 0 8px 24px -8px rgb(0 0 0 / 0.4);
    color: #f4f4f5;
    font:
      500 12px/1.2 ui-sans-serif,
      system-ui,
      sans-serif;
    letter-spacing: normal;
    text-align: left;
    white-space: nowrap;
  }

  /* The only part that may shorten: a long title ends in an ellipsis. */
  .archive-banner-name {
    overflow: hidden;
    min-width: 0;
    text-overflow: ellipsis;
  }

  .archive-banner-mode {
    padding: 2px 8px;
    border-radius: 999px;
    background: #3f3f46;
  }

  .archive-banner a {
    flex: none;
    /* A tap target of 24px or more. */
    padding: 6px 0;
    color: #f4f4f5;
    text-decoration: underline;
    text-decoration-color: #facc15;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* Narrow windows: the name and the two links. */
  @media (max-width: 479.98px) {
    .archive-banner {
      right: 12px;
      gap: 10px;
      max-width: calc(100vw - 24px);
      padding: 0 12px;
    }

    .archive-banner-wide {
      display: none;
    }
  }

  /* Smaller text keeps the longest name ("Ghost blog, 2022–2023") whole at 320px. */
  @media (max-width: 359.98px) {
    .archive-banner {
      gap: 8px;
      padding: 0 10px;
      font-size: 11px;
    }
  }
</style>
