{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // archive.nibras.co: every past version under /<edition>/, as static files.
  "name": "multiverse-archive",
  "account_id": "e02a25d4d8f0bacceba5cb29bcaa74de",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    // The Worker runs only for the index's social card (`src/worker.ts`).
    "run_worker_first": ["/og.png"],
  },
  // Logs and Issues, no traces: the Worker runs for one file. See docs/deploy.md#observability.
  "observability": { "enabled": true, "issues": { "enabled": true } },
  // Stack traces in Issues point to the TypeScript source.
  "upload_source_maps": true,
  // Only the custom domains answer: no workers.dev address and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // A custom domain takes precedence over the wildcard record `*.nibras.co`.
  "routes": [{ "pattern": "archive.nibras.co", "custom_domain": true }],
}
