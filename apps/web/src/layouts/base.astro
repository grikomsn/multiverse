---
import "../styles/global.css"

import SiteFooter from "@multiverse/ui/site-footer.astro"
import SiteHeader from "@multiverse/ui/site-header.astro"
import ThemeHead from "@multiverse/ui/theme-head.astro"

import { SITE_SHELL_QUERY } from "../lib/queries"
import { sanity } from "../lib/sanity"
import { MASCOT_ID, platformLabel } from "@multiverse/sanity/constants"
import { ARCHIVE_ORIGIN } from "../lib/archive"
import { ogOf } from "../lib/og"
import { siteDescription, siteTitle as titleOf } from "../lib/site"

interface Props {
  title?: string
  description?: string | null
  lang?: string | null
  noIndex?: boolean
  canonical?: string | null
  type?: "website" | "article" | "profile"
  /** Full-width column, for the media gallery. */
  wide?: boolean
  /**
   * Absolute URL of the page's own picture for its social card: the resume's.
   * Without it, the page shows the card that the build draws for it (`lib/og.ts`).
   */
  image?: string | null
  imageAlt?: string
  /** When a post came out, and when it changed. For `type="article"`. */
  published?: string | null
  modified?: string | null
  /** Rendered as JSON-LD. */
  structuredData?: object
  /** A Markdown copy of this page, for LLMs and other tools. */
  markdown?: string
  /** Show the reading progress under the header. For posts. */
  progress?: boolean
  /** Start the footer with the contact card, not the one sentence. For About and Work. */
  contactCard?: boolean
}

const {
  title,
  description,
  lang,
  noIndex,
  canonical,
  type = "website",
  wide,
  image,
  imageAlt,
  published,
  modified,
  structuredData,
  markdown,
  progress,
  contactCard,
} = Astro.props
const shell = await sanity.fetch(SITE_SHELL_QUERY)
const siteTitle = titleOf(shell.profile)
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle
const metaDescription = description ?? (siteDescription(shell) || undefined)
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href
// The picture of the social card: the page's own, or the card drawn for the page.
const card = image
  ? { url: image, alt: imageAlt, type: undefined, width: undefined, height: undefined }
  : await ogOf(Astro.url.pathname, Astro.site!.origin)
// The site's language is English. A post in another one says so.
const LOCALES: Record<string, string> = { en: "en_US", id: "id_ID" }
const links = shell.profile?.socialLinks ?? []
const handleOn = (platform: string) =>
  links.find((link) => link.platform === platform && link.url)?.url?.replace(/\/+$/, "")
// X names an author as "@name". Mastodon names one as "@name@server".
const xName = handleOn("x")?.split("/").at(-1)
const fediverse = handleOn("mastodon")?.match(/^https?:\/\/([^/]+)\/@?([^/]+)$/)
const profiles = (shell.profile?.socialLinks ?? [])
  .filter((link) => link.featured && link.url)
  .map((link) => ({
    label: platformLabel(link.platform, link.label),
    url: link.url!,
    platform: link.platform,
  }))
---

<!doctype html>
<html lang={lang ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/feed.xml" />
    <link rel="alternate" type="application/atom+xml" title={siteTitle} href="/atom.xml" />
    <link rel="alternate" type="application/feed+json" title={siteTitle} href="/feed.json" />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <meta name="author" content={siteTitle} />
    <meta property="og:type" content={type} />
    {/* The name of the site has its own tag, so the title of the card does not repeat it. */}
    <meta property="og:title" content={title ?? siteTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={LOCALES[lang ?? "en"] ?? "en_US"} />
    <meta property="og:image" content={card.url} />
    {card.type && <meta property="og:image:type" content={card.type} />}
    {card.width && <meta property="og:image:width" content={String(card.width)} />}
    {card.height && <meta property="og:image:height" content={String(card.height)} />}
    {card.alt && <meta property="og:image:alt" content={card.alt} />}
    {type === "article" && published && (
      <meta property="article:published_time" content={published} />
    )}
    {type === "article" && modified && <meta property="article:modified_time" content={modified} />}
    {/* X and several chat apps show the large picture only with this tag. The rest they read from the tags above. */}
    <meta name="twitter:card" content="summary_large_image" />
    {xName && <meta name="twitter:creator" content={`@${xName}`} />}
    {fediverse && <meta name="fediverse:creator" content={`@${fediverse[2]}@${fediverse[1]}`} />}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
      />
    )}
    <meta name="generator" content={Astro.generator} />
    <ThemeHead />
    <script is:inline>
      // Motion that needs a script (charts, counters, the signature) starts hidden only with
      // this class. Set before the first paint, so nothing jumps.
      if (
        "IntersectionObserver" in window &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
      )
        document.documentElement.classList.add("js-reveal")
    </script>
    <noscript>
      <style>
        .project-mark img {
          visibility: visible !important;
        }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-fg">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-fg px-3 py-2 text-bg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <SiteHeader
      name={siteTitle}
      avatar={shell.avatar?.url}
      mascot={shell.avatar?._id === MASCOT_ID}
      revealBrand={Astro.url.pathname === "/"}
      wide={wide}
      progress={progress}
    />
    {/* The hero wave is wider than the column. This box clips it, so the page never scrolls sideways. */}
    <div class="flex-1 overflow-x-clip">
      <main id="main" class:list={["mx-auto w-full px-5", wide ? "max-w-6xl" : "max-w-2xl"]}>
        <slot />
      </main>
    </div>
    <SiteFooter
      name={shell.profile?.name}
      email={Astro.url.pathname === "/" ? null : shell.profile?.email}
      scheduleUrl={shell.profile?.scheduleUrl}
      card={contactCard}
      profiles={profiles}
      versions={shell.versions}
      archiveUrl={ARCHIVE_ORIGIN}
      wide={wide}
    />
    <script>
      import { startDevelop } from "../scripts/develop"

      startDevelop()

      // A greeting for people who open the browser console: the mascot's wink, then the
      // address of the code. The build puts the whole value at each place that names the
      // constant, so name it once.
      const hello = __CONSOLE_HELLO__
      console.log(
        "%c ",
        `padding: 28px; font-size: 1px; background: url("${hello.face}") center / contain no-repeat`,
      )
      console.log(hello.text)

      // Cards with a pointer light: tell the card under the pointer where the pointer is.
      document.addEventListener(
        "pointermove",
        (event) => {
          const card = (event.target as Element).closest?.<HTMLElement>(".card-spot")
          if (!card) return
          const box = card.getBoundingClientRect()
          card.style.setProperty("--spot-x", `${event.clientX - box.left}px`)
          card.style.setProperty("--spot-y", `${event.clientY - box.top}px`)
        },
        { passive: true },
      )

      // Count a number up from zero (components/count-up.astro). The text is e.g. "116.7k":
      // digits, then a unit.
      function countUp(element: HTMLElement) {
        const value = element.querySelector<HTMLElement>("[data-count-value]")
        const match = value?.textContent?.trim().match(/^(\d+(?:\.(\d+))?)(.*)$/)
        if (!value || !match) return
        const end = Number(match[1])
        const digits = match[2]?.length ?? 0
        const show = (progress: number) => {
          value.textContent = (end * (1 - (1 - progress) ** 4)).toFixed(digits) + match[3]
        }
        show(0)
        const started = performance.now()
        const step = (now: number) => {
          const progress = Math.min(1, (now - started) / 1100)
          show(progress)
          if (progress < 1) requestAnimationFrame(step)
        }
        requestAnimationFrame(step)
      }

      // Things that play once when they enter the view: `data-inview` gets `.is-inview`, and
      // `data-count` counts up.
      if (document.documentElement.classList.contains("js-reveal")) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              observer.unobserve(entry.target)
              if (entry.target.hasAttribute("data-count")) countUp(entry.target as HTMLElement)
              entry.target.classList.add("is-inview")
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        )
        for (const element of document.querySelectorAll("[data-inview], [data-count]")) {
          observer.observe(element)
        }
      }
    </script>
  </body>
</html>
