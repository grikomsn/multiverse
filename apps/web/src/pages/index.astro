---
import DitherWave from "@multiverse/ui/dither-wave.astro"
import { MOODS, type Mood } from "@multiverse/ui/gri"
import Gri from "@multiverse/ui/gri.astro"
import Icon from "@multiverse/ui/icon.astro"
import { formatRange, groupByOrganization, imageUrl, isoDate } from "@multiverse/content/format"
import SectionHeading from "@multiverse/ui/section-heading.astro"
import { FALLBACK_GIVEN_NAME, MASCOT_ID } from "@multiverse/sanity/constants"

import AppRow from "../components/app-row.astro"
import DotIcon from "../components/dot-icon.astro"
import EntryRow from "../components/entry-row.astro"
import Signature from "../components/signature.astro"
import BaseLayout from "../layouts/base.astro"
import { HOME_QUERY, SITE_SHELL_QUERY } from "../lib/queries"
import { sanity } from "../lib/sanity"
import { homeTagline } from "../lib/site"

const [{ profile, avatar }, { site, timeZone, experience, posts, projects, talks }] =
  await Promise.all([sanity.fetch(SITE_SHELL_QUERY), sanity.fetch(HOME_QUERY)])

// While the profile's icon is the mascot, the hero draws it in the page: it winks under the
// pointer, shows the next mood on a click, and answers the links marked `data-gri`.
const mascot = avatar?._id === MASCOT_ID
const current = experience[0]
// A current role at another organization, such as part-time teaching. The intro names it.
const sideJob = experience.find(
  (job) => !job.endDate && job.organization?.name !== current?.organization?.name,
)
const stops = groupByOrganization(experience)
// The highlighted line. Words in [brackets] get a mark; split() with a capture group puts
// them at the odd indexes.
const tagline = homeTagline(site).split(/\[([^\]]+)\]/)
const MARKS = ["--color-mark-red", "--color-mark-green", "--color-mark-blue"]
// What a marked word does under the pointer: the mascot's mood, and an effect around the word
// (global.css). A word that is not here puts stars in the mascot's eyes.
const REACTIONS: Record<string, { mood: Mood; effect: "tools" | "speed" | "hearts" }> = {
  useful: { mood: "think", effect: "tools" },
  fast: { mood: "wow", effect: "speed" },
  friendly: { mood: "love", effect: "hearts" },
}
// The city of the profile's location: "Tangerang" of "Tangerang, Indonesia".
const city = profile?.location?.split(",")[0]?.trim()
// One clip box for each word of the headline, so the words can rise in one after another.
const givenName = profile?.givenName ?? FALLBACK_GIVEN_NAME
const headline = `Hey there, I’m ${givenName}.`.split(" ")
// Where the intro's links go: the GitHub profile (every repository) and the npm
// profile (the packages for coding agents). Without that profile link, the words stay plain.
const profileUrl = (platform: string) =>
  profile?.socialLinks?.find((link) => link.platform === platform)?.url
const toolsUrl = profileUrl("github")
const agentsUrl = profileUrl("npm")

// The same Person `@id` as /resume and /media, so search engines join them.
const origin = Astro.site?.origin ?? "https://nibras.co"
const structuredData = profile?.name && {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${origin}/#website`, url: origin, name: profile.name },
    {
      "@type": "Person",
      "@id": `${origin}/#person`,
      name: profile.name,
      url: origin,
      ...(profile.headline ? { jobTitle: profile.headline } : {}),
      ...(current?.organization?.name
        ? { worksFor: { "@type": "Organization", name: current.organization.name } }
        : {}),
      ...(avatar?.url ? { image: avatar.url } : {}),
      sameAs: (profile.socialLinks ?? []).flatMap((link) => (link.url ? [link.url] : [])),
    },
  ],
}
---

<BaseLayout structuredData={structuredData || undefined}>
  <script is:inline slot="head">
    // The hero entrance plays once in a session (global.css).
    try {
      if (sessionStorage.getItem("entrance")) document.documentElement.classList.add("no-entrance")
      else sessionStorage.setItem("entrance", "1")
    } catch {
      // No storage: the entrance plays on every visit.
    }
  </script>
  <section class="hero relative isolate pt-10 pb-14 sm:pt-16" data-dither-area>
    <DitherWave class="hero-wave" />
    {avatar?.url && (
      <div class="mb-8 flex items-center gap-2">
        {mascot ? (
          <button
            type="button"
            class="hero-avatar size-24 cursor-pointer overflow-hidden rounded-full border border-line transition-[scale] duration-150 active:scale-95 sm:size-28"
            aria-label={`${avatar.alt ?? `Cartoon face of ${givenName}`}. Press it to change its mood.`}
            data-hero
            data-face
            data-time-zone={timeZone}
            data-city={city}
            data-name={givenName}
          >
            <Gri moods={MOODS} />
          </button>
        ) : (
          <img
            src={imageUrl(avatar.url, 240, 240)}
            srcset={`${imageUrl(avatar.url, 120, 120)} 1x, ${imageUrl(avatar.url, 240, 240)} 2x`}
            width="112"
            height="112"
            alt={avatar.alt ?? `Cartoon face of ${givenName}`}
            class="hero-avatar size-24 rounded-full border border-line bg-white sm:size-28"
            data-hero
            fetchpriority="high"
          />
        )}
        <p class="hero-doodle flex items-end gap-1 text-accent-ink" aria-hidden="true">
          <svg class="h-10 w-14" viewBox="0 0 56 40" fill="none">
            <path
              pathLength="1"
              d="M52 31C38 33 19 28 4 16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <path
              pathLength="1"
              d="M13.5 16.5 4 16l2.8 8.8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="-mb-1 inline-block -rotate-6 text-sm font-semibold" data-doodle>
            that’s me
          </span>
        </p>
        {mascot && timeZone && <script is:inline define:vars={{ timeZone }}>
          // Before the first paint: from midnight to 05:00 at home, the face sleeps. No move
          // plays, because the drawing is not live yet.
          try {
            const clock = new Intl.DateTimeFormat("en-GB", {
              hour: "2-digit",
              minute: "2-digit",
              hourCycle: "h23",
              timeZone,
            }).format(new Date())
            const button = document.querySelector("[data-face]")
            const face = button?.querySelector("svg.gri")
            if (button && face && Number(clock.slice(0, 2)) < 5) {
              face.dataset.mood = face.dataset.rest = "sleepy"
              const { city, name } = button.dataset
              button.title = `It is ${clock}${city ? ` in ${city}` : ""}. ${name} is probably asleep.`
              const doodle = document.querySelector("[data-doodle]")
              if (doodle) doodle.textContent = "asleep now"
            }
          } catch {
            // An unknown time zone: the face smiles.
          }
        </script>}
      </div>
    )}
    <h1 class="text-[2.5rem] leading-[1.05] font-bold tracking-tight text-balance sm:text-6xl">
      {headline.map((word, index) => (
        <>
          <span class="hero-word">
            <span style={`--i: ${index}`}>{word}</span>
          </span>{" "}
        </>
      ))}
    </h1>
    <p class="hero-tagline mt-4 text-xl leading-snug font-semibold tracking-tight sm:text-2xl">
      {tagline.map((part, index) =>
        index % 2 ? (
          <mark
            class="mark hero-mark text-fg"
            data-gri={REACTIONS[part.toLowerCase()]?.mood ?? "starstruck"}
            data-effect={REACTIONS[part.toLowerCase()]?.effect}
            style={`--mark: var(${MARKS[((index - 1) / 2) % MARKS.length]}); --i: ${(index - 1) / 2}`}
          >
            {part}
            {REACTIONS[part.toLowerCase()]?.effect === "tools" && (
              <span class="hero-pops" aria-hidden="true">
                <DotIcon name="terminal" style="--i: 0; --turn: -8deg" />
                <DotIcon name="wrench" style="--i: 1; --turn: 6deg" />
                <DotIcon name="box" style="--i: 2; --turn: 14deg" />
              </span>
            )}
            {REACTIONS[part.toLowerCase()]?.effect === "hearts" && (
              <span class="hero-pops hero-hearts" aria-hidden="true">
                <DotIcon name="heart" style="--i: 0; --turn: -12deg" />
                <DotIcon name="heart" style="--i: 1; --turn: 6deg" />
                <DotIcon name="heart" style="--i: 2; --turn: 14deg" />
              </span>
            )}
            {REACTIONS[part.toLowerCase()]?.effect === "speed" && (
              <span class="hero-speed" aria-hidden="true" />
            )}
          </mark>
        ) : (
          part
        ),
      )}
    </p>
    <div class="hero-intro mt-8 flex flex-col gap-3 text-lg leading-relaxed text-soft [&_a]:quiet-link [&_a]:text-fg">
      {current && (
        <p>
          I lead engineering at{" "}
          {current.organization?.url ? (
            <a href={current.organization.url}>{current.organization.name}</a>
          ) : (
            current.organization?.name
          )}
          {sideJob?.organization?.name && (
            <>
              {" "}
              and teach new developers at{" "}
              {sideJob.organization.url ? (
                <a href={sideJob.organization.url}>{sideJob.organization.name}</a>
              ) : (
                sideJob.organization.name
              )}
            </>
          )}
          . I also make {toolsUrl ? <a href={toolsUrl}>developer tools</a> : "developer tools"} for
          humans, and lately for {agentsUrl ? <a href={agentsUrl}>AI agents</a> : "AI agents"} too.
          {profile?.location &&
            (timeZone ? (
              <>
                {" "}
                I live in{" "}
                <span class="place">
                  <button
                    type="button"
                    data-place
                    data-time-zone={timeZone}
                    aria-describedby="place-time"
                  >
                    {profile.location}
                  </button>
                  <span class="place-time" id="place-time" role="tooltip">
                    <DotIcon name="sun" class="place-sun" />
                    <DotIcon name="moon" class="place-moon" />
                    <span>
                      <b data-clock /> there now
                      <small data-zone />
                    </span>
                  </span>
                </span>
                .
              </>
            ) : (
              <> I live in {profile.location}.</>
            ))}
        </p>
      )}
    </div>
    <nav class="hero-actions mt-6 flex flex-wrap gap-2" aria-label="Shortcuts">
      <a class="button" href="/resume" data-gri="cool">
        <Icon name="file-text" class="size-4 text-accent-ink" />
        Resume
      </a>
      {profile?.scheduleUrl && (
        <a class="button" href={profile.scheduleUrl} data-gri="laugh">
          <Icon name="calendar" class="size-4 text-accent-ink" />
          Book a call
        </a>
      )}
    </nav>
  </section>

  {projects.length > 0 && (
    <section class="border-t border-line py-10" data-reveal>
      <SectionHeading
        title="Apps and things"
        id="apps"
        href="/work#projects"
        link="All projects"
        icon="app-window"
      />
      <ul class="flex flex-col">
        {projects.map((project) => (
          <AppRow project={project} />
        ))}
      </ul>
    </section>
  )}

  <section class="border-t border-line py-10" data-reveal>
    <SectionHeading title="Experience" href="/work" link="Full work history" icon="briefcase" />
    <ul class="flex flex-col">
      {stops.map((stop) => (
        <EntryRow
          title={stop.organization?.name ?? ""}
          href={stop.organization?.url}
          detail={stop.roles.map((job) => job.role).join(", ")}
          date={formatRange(stop.startDate, stop.endDate)}
          current={!stop.endDate}
        />
      ))}
    </ul>
  </section>

  {talks.length > 0 && (
    <section class="border-t border-line py-10" data-reveal>
      <SectionHeading title="Talks" href="/work#talks" link="All talks" icon="mic" />
      <ul class="flex flex-col">
        {talks.map((talk) => (
          <EntryRow
            title={talk.title ?? ""}
            href={talk.url}
            detail={talk.event}
            date={isoDate(talk.date)}
            datetime={talk.date}
          />
        ))}
      </ul>
    </section>
  )}

  <section class="border-t border-line py-10" data-reveal>
    <SectionHeading title="Latest posts" href="/blog" link="All posts" icon="pen" />
    <ul class="flex flex-col">
      {posts.map((post) => (
        <EntryRow
          title={post.title ?? ""}
          href={`/${post.slug}`}
          date={isoDate(post.publishedAt)}
          datetime={post.publishedAt}
          transition={`post-${post.slug}`}
        />
      ))}
    </ul>
  </section>

  <section class="border-t border-line pt-14 pb-6" aria-labelledby="say-hi" data-reveal>
    <h2
      id="say-hi"
      class="text-2xl leading-snug font-semibold tracking-tight text-balance sm:text-3xl"
    >
      Have something in mind? I am happy to talk about work, open source, or anything on this site.
    </h2>
    <p class="mt-5 text-lg leading-relaxed text-soft [&_a]:quiet-link [&_a]:text-fg">
      {profile?.email && (
        <>
          Send an email to <a href={`mailto:${profile.email}`}>{profile.email}</a>
          {profile.scheduleUrl ? (
            <>
              , or <a href={profile.scheduleUrl}>book a call</a>.
            </>
          ) : (
            "."
          )}{" "}
        </>
      )}
      You can also <a href="/ai">ask an AI about me</a>.
    </p>
    <Signature class="mt-8 w-40 sm:w-44" label={givenName} />
  </section>
</BaseLayout>

<script>
  import { faces, look, showMood } from "@multiverse/ui/gri-moods"

  // The face in the hero. `data-rest` holds the mood that a click chose.
  const hero = document.querySelector<HTMLElement>(".hero")
  const button = hero?.querySelector<HTMLElement>("[data-face]")
  const face = button && faces(button)[0]
  if (hero && button && face) {
    // The moods in the order that the drawing holds them.
    const moods = [
      ...new Set(
        [...face.querySelectorAll<SVGElement>("g[data-m] > .mouth")].map(
          (mouth) => (mouth.parentNode as SVGElement).dataset.m!,
        ),
      ),
    ]
    // True while the face is dizzy from too many clicks: nothing else changes its mood.
    let dizzy = false
    const rest = () => face.dataset.rest ?? "smile"
    const show = (mood: string) => {
      if (!dizzy && face.dataset.mood !== mood) showMood(face, mood)
    }
    /** A mood while the pointer or the keyboard focus is on `item`. */
    const answer = (item: HTMLElement, mood: () => string | undefined) => {
      const enter = () => {
        const next = mood()
        if (next) show(next)
      }
      const leave = () => show(rest())
      item.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") enter()
      })
      item.addEventListener("pointerleave", leave)
      item.addEventListener("focus", enter)
      item.addEventListener("blur", leave)
    }

    // A wink under the pointer, until a click has chosen a different mood.
    answer(button, () => (rest() === "smile" ? "wink" : undefined))

    // A click shows the next mood. A click also wakes a face that sleeps at night. Five quick
    // clicks make the face dizzy, then grumpy, and it ignores clicks until it smiles again.
    const doodle = hero.querySelector<HTMLElement>("[data-doodle]")
    const label = doodle?.textContent
    let pokes = 0
    let poked = 0
    button.addEventListener("click", () => {
      if (dizzy) return
      button.removeAttribute("title")
      if (doodle && label) doodle.textContent = label
      const now = performance.now()
      pokes = now - poked < 600 ? pokes + 1 : 1
      poked = now
      if (pokes < 5) {
        const next = moods[(moods.indexOf(rest()) + 1) % moods.length] ?? "smile"
        face.dataset.rest = next
        showMood(face, next)
        return
      }
      pokes = 0
      dizzy = true
      delete face.dataset.rest
      showMood(face, "dizzy")
      window.setTimeout(() => showMood(face, "grumpy"), 1700)
      window.setTimeout(() => {
        dizzy = false
        showMood(face, "smile")
      }, 4200)
    })
    for (const item of hero.querySelectorAll<HTMLElement>("[data-gri]")) {
      answer(item, () => item.dataset.gri)
    }

    // The head and the eyes lean toward the pointer while it is over the hero (`gri.css`).
    // A sleepy or dizzy face does not look around.
    look(face, hero, 260, { quiet: () => ["sleepy", "dizzy"].includes(face.dataset.mood ?? "") })
  }

  // The city in the intro shows the time there, with a sun from 06:00 to 18:00 and a moon
  // at night.
  const place = document.querySelector<HTMLElement>("[data-place]")
  const tip = place?.parentElement?.querySelector<HTMLElement>(".place-time")
  const timeZone = place?.dataset.timeZone
  if (place && tip && timeZone) {
    const fill = () => {
      const now = new Date()
      const clock = new Intl.DateTimeFormat("en-GB", {
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
        timeZone,
      }).format(now)
      const offset = new Intl.DateTimeFormat("en", { timeZone, timeZoneName: "shortOffset" })
        .formatToParts(now)
        .find((part) => part.type === "timeZoneName")
        ?.value.replace("GMT", "UTC")
      const hour = Number(clock.slice(0, 2))
      const day = hour >= 6 && hour < 18
      tip.dataset.part = day ? "day" : "night"
      tip.querySelector("[data-clock]")!.textContent = clock
      tip.querySelector("[data-zone]")!.textContent = [day ? "Day" : "Night", offset]
        .filter(Boolean)
        .join(" · ")
    }
    try {
      fill()
      for (const type of ["pointerenter", "focus"]) place.addEventListener(type, fill)
      place.parentElement!.dataset.ready = ""
    } catch {
      // An unknown time zone: the city stays plain text.
    }
  }
</script>
