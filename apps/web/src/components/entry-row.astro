---
/**
 * One dated row of a list: a post, a talk, a role, a school. The title and the summary are on
 * the left, and the date is on the right. On a narrow screen the date goes under the title.
 */
interface Props {
  title: string
  /** Where the title goes. Without it the title is plain text. */
  href?: string | null
  /** The whole row opens the link. Only for a row with no other link in it. */
  stretch?: boolean
  /** A second fact after the title: the roles, the event. */
  detail?: string | null
  /** The date as the row shows it: "2025-07-21", "2020 – 2023". */
  date?: string | null
  /** The same date for machines, when it is one day. */
  datetime?: string | null
  /** Show the green dot of a current role. */
  current?: boolean
  summary?: string | null
  /** The title's `view-transition-name`, so a post title moves into its page. */
  transition?: string
}

const { title, href, stretch, detail, date, datetime, current, summary, transition } = Astro.props
const style = transition ? `view-transition-name: ${transition}` : undefined
---

<li
  class:list={[
    "grid gap-x-6 py-2.5 sm:grid-cols-[1fr_auto] sm:items-baseline",
    href && stretch && "relative",
  ]}
>
  <p>
    {href ? (
      <a
        class:list={[
          // The padding makes the tap target 24 px tall. It is inline, so the row keeps its height.
          "title-link py-1 font-semibold",
          stretch && "after:absolute after:inset-0",
        ]}
        href={href}
        style={style}
      >
        {title}
      </a>
    ) : (
      <span class="font-semibold" style={style}>
        {title}
      </span>
    )}
    {detail && <span class="text-soft"> · {detail}</span>}
  </p>
  {date && (
    <p class="flex shrink-0 items-center gap-2 font-mono text-[0.8125rem] whitespace-nowrap text-soft">
      {current && (
        <span class="relative flex size-2" title="Current role">
          <span class="absolute inline-flex size-full rounded-full bg-mark-green-ink opacity-60 motion-safe:animate-ping" />
          <span class="relative inline-flex size-2 rounded-full bg-mark-green-ink" />
        </span>
      )}
      {datetime ? <time datetime={datetime}>{date}</time> : date}
    </p>
  )}
  {summary && <p class="mt-0.5 text-[0.9375rem] text-soft sm:col-start-1">{summary}</p>}
</li>
