---
import Icon from "@multiverse/ui/icon.astro"

import type { Metrics } from "../lib/metrics"
import { KIND, KIND_ICON, linkLabel, STATUS } from "../lib/projects"
import ProjectMark from "./project-mark.astro"
import ProjectStats from "./project-stats.astro"

interface Props {
  project: {
    name: string | null
    kind?: string | null
    status?: string | null
    url?: string | null
    repoUrl?: string | null
    summary?: string | null
    icon?: { url: string | null; extension?: string | null } | null
  }
  metrics?: Metrics
  /** Clamp the summary to two lines, for the home page. */
  clamp?: boolean
}

const { project, metrics, clamp } = Astro.props
const href = project.url ?? project.repoUrl
---

<article class="card card-spot flex h-full flex-col" data-mark-area>
  <ProjectMark icon={project.icon} class="rounded-t-[calc(0.75rem-1px)] border-b border-line" />
  <div class="flex flex-1 flex-col gap-2 px-4 py-4">
    <p class="label flex items-center justify-between gap-3 text-xs">
      <span class="flex items-center gap-1.5">
        <Icon name={KIND_ICON[project.kind ?? ""] ?? "package"} class="size-3.5 text-accent-ink" />
        {KIND[project.kind ?? ""] ?? "Project"}
      </span>
      {project.status && STATUS[project.status] && (
        <span class="font-normal normal-case">{STATUS[project.status]}</span>
      )}
    </p>
    <h3 class="text-lg leading-snug font-bold tracking-tight">
      {href ? (
        <a class="link decoration-transparent hover:decoration-accent" href={href}>
          {project.name}
        </a>
      ) : (
        project.name
      )}
    </h3>
    <p class:list={["text-[0.9375rem] text-soft", clamp && "line-clamp-2"]}>{project.summary}</p>
    <ProjectStats metrics={metrics} />
    <p class="mt-auto flex flex-wrap gap-x-4 pt-1 text-sm text-soft">
      {project.url && (
        <a class="inline-block py-1 hover:text-fg" href={project.url}>
          {linkLabel(project.url)}
        </a>
      )}
      {project.repoUrl && project.repoUrl !== project.url && (
        <a class="inline-block py-1 hover:text-fg" href={project.repoUrl}>
          Source code
        </a>
      )}
    </p>
  </div>
</article>
